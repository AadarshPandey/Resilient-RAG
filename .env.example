# LLM Providers
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

# Pipeline Settings
RAG_LLM_CHAIN=google:gemini-2.5-flash,google:gemini-2.5-pro
RAG_HEALING_ENABLED=true
RAG_MAX_HEAL_ATTEMPTS=4
RAG_DEVICE=auto

# Storage (Phase 1 uses local Qdrant and SQLite by default)
# RAG_QDRANT_URL=http://localhost:6333
# RAG_CHECKPOINT_DSN=sqlite:///data/checkpoints.db

# LangSmith Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=resilient-rag
